diff --git a/loomis_head/qt_compat.py b/loomis_head/qt_compat.py
new file mode 100644
index 0000000..e08b885
--- /dev/null
+++ b/loomis_head/qt_compat.py
@@ -0,0 +1,196 @@
+# SPDX-FileCopyrightText: 2026 imboolean
+# SPDX-License-Identifier: GPL-3.0-only
+
+"""Capa de compatibilidad PyQt5 / PyQt6 para Krita 5 y Krita 6.
+
+Krita 5.3.x trae PyQt5; Krita 6 pasa a PyQt6. Los modulos del plugin importan
+todo desde aqui y nunca desde ``PyQt5``/``PyQt6`` directamente.
+
+Diferencias que cubre este modulo:
+
+- PyQt6 elimina los enums sin ambito: ``Qt.Horizontal`` deja de existir y hay
+  que escribir ``Qt.Orientation.Horizontal``. El objeto ``Qt`` que se exporta
+  en PyQt6 mapea los nombres cortos que usa el plugin.
+- ``QColor.name(QColor.HexRgb)``: ``HexRgb`` es el formato por defecto en ambas
+  versiones, asi que los modulos llaman a ``col.name()``.
+- ``QDialog.exec_()`` desaparece en PyQt6 (queda ``exec()``): se usa
+  ``exec_dialog(dlg)``.
+- ``QSizePolicy.Expanding`` pasa a ``QSizePolicy.Policy.Expanding``: se usa
+  ``EXPANDING``.
+- Otros enums escopados que aparecen en el codigo (``QStandardPaths``,
+  ``QColorDialog``, ``QFrame``, ``QPainter``) se reexportan como subclases con
+  el nombre corto, para no tener que tocar esas lineas en los modulos.
+"""
+from __future__ import annotations
+
+try:  # Krita 5.x
+    from PyQt5 import QtCore, QtGui, QtSvg, QtWidgets, uic
+
+    QT6 = False
+except ImportError:  # Krita 6.x
+    from PyQt6 import QtCore, QtGui, QtSvg, QtWidgets, uic
+
+    QT6 = True
+
+# --- QtCore -----------------------------------------------------------------
+QByteArray = QtCore.QByteArray
+QDateTime = QtCore.QDateTime
+QLocale = QtCore.QLocale
+QPointF = QtCore.QPointF
+QRect = QtCore.QRect
+QSignalBlocker = QtCore.QSignalBlocker
+QStandardPaths = QtCore.QStandardPaths
+QTimer = QtCore.QTimer
+pyqtSignal = QtCore.pyqtSignal
+
+# --- QtGui ------------------------------------------------------------------
+QBrush = QtGui.QBrush
+QColor = QtGui.QColor
+QPainter = QtGui.QPainter
+QPen = QtGui.QPen
+QTransform = QtGui.QTransform
+
+# --- QtWidgets --------------------------------------------------------------
+QCheckBox = QtWidgets.QCheckBox
+QColorDialog = QtWidgets.QColorDialog
+QComboBox = QtWidgets.QComboBox
+QFileDialog = QtWidgets.QFileDialog
+QFormLayout = QtWidgets.QFormLayout
+QFrame = QtWidgets.QFrame
+QGridLayout = QtWidgets.QGridLayout
+QGroupBox = QtWidgets.QGroupBox
+QHBoxLayout = QtWidgets.QHBoxLayout
+QLabel = QtWidgets.QLabel
+QScrollArea = QtWidgets.QScrollArea
+QSizePolicy = QtWidgets.QSizePolicy
+QSlider = QtWidgets.QSlider
+QSpinBox = QtWidgets.QSpinBox
+QStackedWidget = QtWidgets.QStackedWidget
+QTabWidget = QtWidgets.QTabWidget
+QVBoxLayout = QtWidgets.QVBoxLayout
+QWidget = QtWidgets.QWidget
+
+# --- QtSvg ------------------------------------------------------------------
+QSvgRenderer = QtSvg.QSvgRenderer
+
+
+class _Qt6Namespace:
+    """Nombres cortos de enum que usa el plugin, resueltos a PyQt6 escopado.
+
+    Cualquier otro atributo se delega al ``Qt`` real de PyQt6.
+    """
+
+    Horizontal = QtCore.Qt.Orientation.Horizontal
+    LeftButton = QtCore.Qt.MouseButton.LeftButton
+    RightButton = QtCore.Qt.MouseButton.RightButton
+    NoPen = QtCore.Qt.PenStyle.NoPen
+    NoBrush = QtCore.Qt.BrushStyle.NoBrush
+    OpenHandCursor = QtCore.Qt.CursorShape.OpenHandCursor
+    ClosedHandCursor = QtCore.Qt.CursorShape.ClosedHandCursor
+    ScrollBarAlwaysOff = QtCore.Qt.ScrollBarPolicy.ScrollBarAlwaysOff
+    ShiftModifier = QtCore.Qt.KeyboardModifier.ShiftModifier
+
+    def __getattr__(self, name):
+        try:
+            return getattr(QtCore.Qt, name)
+        except AttributeError:
+            raise AttributeError(f"Qt.{name} no existe en PyQt6") from None
+
+
+if QT6:
+
+    Qt = _Qt6Namespace()
+    EXPANDING = QtWidgets.QSizePolicy.Policy.Expanding
+
+    def exec_dialog(dlg):
+        """Ejecuta un dialogo modal (``exec()`` en PyQt6)."""
+        return dlg.exec()
+
+    def activated_index(combo):
+        """Senal ``activated`` con indice; en PyQt6 solo queda esa firma."""
+        return combo.activated
+
+    def activated_text(combo):
+        """Senal ``activated`` con texto; en Qt6 se llama ``textActivated``."""
+        return combo.textActivated
+
+    class QStandardPaths(QtCore.QStandardPaths):  # noqa: N801
+        """``QStandardPaths`` con los nombres cortos de ubicacion."""
+
+        AppDataLocation = QtCore.QStandardPaths.StandardLocation.AppDataLocation
+
+    class QColorDialog(QtWidgets.QColorDialog):  # noqa: N801
+        """``QColorDialog`` con los nombres cortos de opcion."""
+
+        DontUseNativeDialog = QtWidgets.QColorDialog.ColorDialogOption.DontUseNativeDialog
+
+    class QFrame(QtWidgets.QFrame):  # noqa: N801
+        """``QFrame`` con los nombres cortos de forma."""
+
+        NoFrame = QtWidgets.QFrame.Shape.NoFrame
+
+    class QPainter(QtGui.QPainter):  # noqa: N801
+        """``QPainter`` con el nombre corto ``Antialiasing``."""
+
+        Antialiasing = QtGui.QPainter.RenderHint.Antialiasing
+
+else:
+
+    Qt = QtCore.Qt
+    EXPANDING = QtWidgets.QSizePolicy.Expanding
+
+    def exec_dialog(dlg):
+        """Ejecuta un dialogo modal (``exec_()`` en PyQt5)."""
+        return dlg.exec_()
+
+    def activated_index(combo):
+        """Senal ``activated`` con indice (``activated[int]`` en PyQt5)."""
+        return combo.activated[int]
+
+    def activated_text(combo):
+        """Senal ``activated`` con texto (``activated[str]`` en PyQt5)."""
+        return combo.activated[str]
+
+
+__all__ = [
+    "QT6",
+    "EXPANDING",
+    "QBrush",
+    "QByteArray",
+    "QCheckBox",
+    "QColor",
+    "QColorDialog",
+    "QComboBox",
+    "QDateTime",
+    "QFileDialog",
+    "QFormLayout",
+    "QFrame",
+    "QGridLayout",
+    "QGroupBox",
+    "QHBoxLayout",
+    "QLabel",
+    "QLocale",
+    "QPainter",
+    "QPen",
+    "QPointF",
+    "QRect",
+    "QScrollArea",
+    "QSignalBlocker",
+    "QSizePolicy",
+    "QSlider",
+    "QSpinBox",
+    "QStackedWidget",
+    "QStandardPaths",
+    "QSvgRenderer",
+    "QTabWidget",
+    "QTimer",
+    "QTransform",
+    "QVBoxLayout",
+    "QWidget",
+    "Qt",
+    "activated_index",
+    "activated_text",
+    "exec_dialog",
+    "pyqtSignal",
+    "uic",
+]
diff --git a/loomis_head/test_asaro.py b/loomis_head/test_asaro.py
new file mode 100644
index 0000000..3157d0c
--- /dev/null
+++ b/loomis_head/test_asaro.py
@@ -0,0 +1,1147 @@
+# SPDX-FileCopyrightText: 2026 imboolean
+# SPDX-License-Identifier: GPL-3.0-only
+
+"""Pruebas de la cabeza Asaro y del registro de modelos (sin Krita).
+
+El modelo dibuja el retopo de planos de ``asaro_clean_mesh``; la decimacion
+exacta del OBJ queda en ``asaro_mesh`` como referencia para medir la silueta.
+Las pruebas cubren las dos mallas (manifold, simetria, conteo, silueta) y el
+SVG que sale de la cabeza (toggles, relleno de planos, ida y vuelta).
+
+Ejecutar desde esta carpeta:
+    python3 -m unittest test_asaro.py -v
+"""
+import math
+import re
+import sys
+import types
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+# El paquete real importa krita en __init__.py; aqui solo probamos los modelos.
+_pkg = types.ModuleType("loomis_head")
+_pkg.__path__ = [str(Path(__file__).resolve().parent)]
+sys.modules.setdefault("loomis_head", _pkg)
+
+from loomis_head import asaro_clean_mesh, asaro_mesh  # noqa: E402
+from loomis_head.asaro import (  # noqa: E402
+    EDGE_COLOR,
+    PLANE_COLOR,
+    _SHADE_TONES,
+    AsaroHead,
+    _newell,
+)
+from loomis_head.linalg import q_axis_angle  # noqa: E402
+from loomis_head.euclid import Vector3  # noqa: E402
+from loomis_head.models import (  # noqa: E402
+    DEFAULT_MODEL,
+    MODELS,
+    create_model,
+    supported_models,
+)
+
+
+def _valid_svg(test: unittest.TestCase, svg: str) -> None:
+    test.assertIn("<svg", svg)
+    test.assertTrue(svg.endswith("</svg>"))
+    test.assertNotIn("nan", svg.lower())
+    test.assertNotIn("inf", svg.lower())
+    ET.fromstring(svg)  # XML bien formado
+
+
+def _band(vertices, low: float, high: float, half_width: float = 0.12):
+    """Vertices de una franja de altura cerca del plano sagital."""
+    return [p for p in vertices if low <= p[1] < high and abs(p[0]) < half_width]
+
+
+def _front(vertices, low: float, high: float) -> float:
+    """Profundidad maxima (lo que mas sobresale) en una franja de altura."""
+    band = _band(vertices, low, high)
+    return max((p[2] for p in band), default=float("-inf"))
+
+
+def _face_area(vertices, face) -> float:
+    """Area de un poligono (abanico de triangulos), sin depender de que sea plano."""
+    pts = [vertices[i] for i in face]
+    area = 0.0
+    for i in range(1, len(pts) - 1):
+        ax = [pts[i][k] - pts[0][k] for k in range(3)]
+        bx = [pts[i + 1][k] - pts[0][k] for k in range(3)]
+        cross = (
+            ax[1] * bx[2] - ax[2] * bx[1],
+            ax[2] * bx[0] - ax[0] * bx[2],
+            ax[0] * bx[1] - ax[1] * bx[0],
+        )
+        area += 0.5 * math.sqrt(sum(c * c for c in cross))
+    return area
+
+
+def _edge_use(faces) -> dict[tuple[int, int], int]:
+    use: dict[tuple[int, int], int] = {}
+    for face in faces:
+        n = len(face)
+        for i in range(n):
+            a, b = face[i], face[(i + 1) % n]
+            key = (a, b) if a < b else (b, a)
+            use[key] = use.get(key, 0) + 1
+    return use
+
+
+def _rasterize(verts, faces, yaw_deg, size=400, span=1.62) -> bytearray:
+    """Silueta rasterizada (relleno de scanline par-impar, sin dependencias).
+
+    Misma camara ortografica que los renders: giro en Y, alto 1.5 centrado y
+    ``span`` de margen. Devuelve una mascara de ``size * size`` bytes.
+    """
+    yaw = math.radians(yaw_deg)
+    cos_y, sin_y = math.cos(yaw), math.sin(yaw)
+    scale = size / span
+    projected = [
+        (size / 2.0 + (x * cos_y + z * sin_y) * scale,
+         size / 2.0 - (y + 0.02) * scale)
+        for x, y, z in verts
+    ]
+    mask = bytearray(size * size)
+    for face in faces:
+        points = [projected[i] for i in face]
+        ys = [p[1] for p in points]
+        first = max(0, int(math.ceil(min(ys))))
+        last = min(size - 1, int(math.floor(max(ys))))
+        for row in range(first, last + 1):
+            line = row + 0.5
+            crossings = []
+            n = len(points)
+            for i in range(n):
+                ax, ay = points[i]
+                bx, by = points[(i + 1) % n]
+                if (ay <= line < by) or (by <= line < ay):
+                    t = (line - ay) / (by - ay)
+                    crossings.append(ax + (bx - ax) * t)
+            crossings.sort()
+            base = row * size
+            for k in range(0, len(crossings) - 1, 2):
+                x0 = max(0, int(math.ceil(crossings[k])))
+                x1 = min(size - 1, int(math.floor(crossings[k + 1])))
+                for column in range(x0, x1 + 1):
+                    mask[base + column] = 1
+    return mask
+
+
+def _iou(a: bytearray, b: bytearray) -> float:
+    inter = union = 0
+    for va, vb in zip(a, b):
+        if va or vb:
+            union += 1
+            if va and vb:
+                inter += 1
+    return inter / union if union else 0.0
+
+
+def _row_spans(mask: bytearray, size: int):
+    spans = []
+    for row in range(size):
+        base = row * size
+        line = mask[base:base + size]
+        if not any(line):
+            continue
+        left = line.index(1)
+        right = size - 1 - line[::-1].index(1)
+        spans.append((row, left, right))
+    return spans
+
+
+def _row_deltas(mask_a, mask_b, size, span=1.62):
+    """Diferencia de borde izquierdo/derecho por fila, en unidades de modelo."""
+    left = {row: (a, b) for row, a, b in _row_spans(mask_a, size)}
+    right = {row: (a, b) for row, a, b in _row_spans(mask_b, size)}
+    deltas = []
+    for row in sorted(set(left) & set(right)):
+        la, ra = left[row]
+        lb, rb = right[row]
+        deltas.append(max(abs(la - lb), abs(ra - rb)) * span / size)
+    return deltas
+
+
+_EXACT_MASKS: dict[tuple[float, int, float], bytearray] = {}
+
+
+def _exact_mask(yaw, size=400, span=1.62) -> bytearray:
+    """Mascara de la malla exacta (cacheada: rasterizarla es lo caro)."""
+    key = (yaw, size, span)
