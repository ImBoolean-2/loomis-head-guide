+    @staticmethod
+    def _rotated(degrees, dx=0.0, dy=0.0):
+        angle = math.radians(degrees)
+        return (
+            math.cos(angle), math.sin(angle),
+            -math.sin(angle), math.cos(angle),
+            float(dx), float(dy),
+        )
