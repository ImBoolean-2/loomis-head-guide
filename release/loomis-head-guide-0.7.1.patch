+            for detail in (0, 1, 2):
+                head.set_detail(detail)
+                svg = head.build_svg(800, 800)
+                _valid_svg(self, svg)
+                self.assertIn("<path", svg)
+                self.assertIn('title="asaro-planes"', svg)
+                self.assertIn('title="asaro-edges"', svg)
